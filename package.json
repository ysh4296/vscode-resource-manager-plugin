{
  "name": "mfe-resource-registry",
  "displayName": "MFE Resource Registry",
  "description": "Manage MFE deployment resource registry JSON via each resource's live package.json version on GitLab, with Git commit/push automation.",
  "version": "0.1.0",
  "publisher": "local-dev",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mfeResourceRegistry",
          "title": "MFE Resource Registry",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "mfeResourceRegistry": [
        {
          "id": "mfeResourceRegistry.view",
          "name": "Resource Registry",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "mfeResourceRegistry.open",
        "title": "MFE Resource Registry: Open"
      },
      {
        "command": "mfeResourceRegistry.configure",
        "title": "MFE Resource Registry: Configure Repository"
      },
      {
        "command": "mfeResourceRegistry.openInEditor",
        "title": "MFE Resource Registry: Open in Editor Tab"
      }
    ],
    "configuration": {
      "title": "MFE Resource Registry",
      "properties": {
        "mfeResourceRegistry.repositoryUrl": {
          "type": "string",
          "default": "",
          "description": "Git clone URL (SSH or HTTPS) of the repository that holds the registry JSON. The extension manages its own local clone of this repo — it does not use whatever folder happens to be open in VS Code."
        },
        "mfeResourceRegistry.jsonPath": {
          "type": "string",
          "default": "resources.json",
          "description": "Path (relative to the repository root) of the registry JSON file managed by this extension"
        },
        "mfeResourceRegistry.entryFile": {
          "type": "string",
          "default": "remoteEntry.js",
          "description": "Entry file name appended to generated resource URLs, e.g. remoteEntry.js"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit -p ./",
    "test": "node --import tsx --test $(find src -name '*.test.ts')"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "semver": "^7.6.3",
    "simple-git": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/semver": "^7.5.8",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.32.0",
    "esbuild": "^0.21.5",
    "tsx": "^4.23.13",
    "typescript": "^5.5.3"
  }
}
